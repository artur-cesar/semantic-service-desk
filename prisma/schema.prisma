generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ActorType {
  HUMAN
  AI_AGENT
  SERVICE

  @@map("actor_type")
}

enum TicketStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  CANCELED

  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("ticket_priority")
}

enum TicketSource {
  WEB
  API
  AGENT

  @@map("ticket_source")
}

enum TicketCommentVisibility {
  PUBLIC
  INTERNAL

  @@map("ticket_comment_visibility")
}

enum TicketEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  COMMENT_ADDED
  ANALYSIS_REQUESTED
  ANALYSIS_COMPLETED
  RESOLVED
  CLOSED
  CANCELED

  @@map("ticket_event_type")
}

enum TicketAnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SUPERSEDED

  @@map("ticket_analysis_status")
}

enum TicketAnalysisTrigger {
  MANUAL
  TICKET_CREATED
  TICKET_UPDATED
  ONTOLOGY_UPDATED

  @@map("ticket_analysis_trigger")
}

enum CapabilityRequirementSource {
  ONTOLOGY
  POLICY
  HUMAN

  @@map("capability_requirement_source")
}

model Actor {
  id           String    @id @default(uuid()) @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  type         ActorType
  name         String
  email        String?   @unique
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  department       Department                 @relation(fields: [departmentId], references: [id])
  authorizations   ActorSystemAuthorization[]
  capabilities     ActorCapability[]
  memberships      TeamMembership[]
  assignedTickets  Ticket[]                   @relation("TicketAssignee")
  comments         TicketComment[]
  events           TicketEvent[]
  evaluations      ActorEvaluation[]
  requestedTickets Ticket[]                   @relation("TicketRequester")

  @@index([departmentId])
  @@map("actors")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  actors                     Actor[]
  teams                      Team[]
  previousDepartmentTickets  Ticket[] @relation("TicketPreviousDepartment")
  requesterDepartmentTickets Ticket[] @relation("TicketRequesterDepartment")

  @@map("departments")
}

model Team {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  code         String   @unique
  name         String
  description  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department  Department       @relation(fields: [departmentId], references: [id])
  memberships TeamMembership[]
  tickets     Ticket[]

  @@index([departmentId])
  @@map("teams")
}

model TeamMembership {
  id        String    @id @default(uuid()) @db.Uuid
  teamId    String    @map("team_id") @db.Uuid
  actorId   String    @map("actor_id") @db.Uuid
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")

  actor Actor @relation(fields: [actorId], references: [id])
  team  Team  @relation(fields: [teamId], references: [id])

  @@index([actorId])
  @@index([teamId])
  @@map("team_memberships")
}

model Capability {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  actors               ActorCapability[]
  analysisRequirements AnalysisCapabilityRequirement[]

  @@map("capabilities")
}

model ActorCapability {
  id           String    @id @default(uuid()) @db.Uuid
  actorId      String    @map("actor_id") @db.Uuid
  capabilityId String    @map("capability_id") @db.Uuid
  grantedAt    DateTime  @default(now()) @map("granted_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  actor      Actor      @relation(fields: [actorId], references: [id])
  capability Capability @relation(fields: [capabilityId], references: [id])

  @@index([actorId])
  @@index([capabilityId])
  @@map("actor_capabilities")
}

model BusinessSystem {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  actions        BusinessAction[]
  authorizations ActorSystemAuthorization[]
  tickets        Ticket[]

  @@map("business_systems")
}

model BusinessAction {
  id          String   @id @default(uuid()) @db.Uuid
  systemId    String   @map("system_id") @db.Uuid
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  system  BusinessSystem @relation(fields: [systemId], references: [id])
  tickets Ticket[]

  @@index([systemId])
  @@map("business_actions")
}

model TicketCategory {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent            TicketCategory?  @relation("TicketCategoryHierarchy", fields: [parentId], references: [id])
  children          TicketCategory[] @relation("TicketCategoryHierarchy")
  suggestedAnalyses TicketAnalysis[]
  tickets           Ticket[]

  @@index([parentId])
  @@map("ticket_categories")
}

model ActorSystemAuthorization {
  id        String    @id @default(uuid()) @db.Uuid
  actorId   String    @map("actor_id") @db.Uuid
  systemId  String    @map("system_id") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  actor  Actor          @relation(fields: [actorId], references: [id])
  system BusinessSystem @relation(fields: [systemId], references: [id])

  @@index([actorId])
  @@index([systemId])
  @@map("actor_system_authorizations")
}

model Ticket {
  id                    String         @id @default(uuid()) @db.Uuid
  number                Int            @unique @default(autoincrement())
  title                 String
  description           String
  status                TicketStatus   @default(OPEN)
  priority              TicketPriority @default(MEDIUM)
  source                TicketSource   @default(API)
  requesterId           String         @map("requester_id") @db.Uuid
  assigneeId            String?        @map("assignee_id") @db.Uuid
  teamId                String?        @map("team_id") @db.Uuid
  categoryId            String?        @map("category_id") @db.Uuid
  affectedSystemId      String?        @map("affected_system_id") @db.Uuid
  requestedActionId     String?        @map("requested_action_id") @db.Uuid
  requesterDepartmentId String?        @map("requester_department_id") @db.Uuid
  previousDepartmentId  String?        @map("previous_department_id") @db.Uuid
  dueAt                 DateTime?      @map("due_at")
  resolutionSummary     String?        @map("resolution_summary")
  resolvedAt            DateTime?      @map("resolved_at")
  closedAt              DateTime?      @map("closed_at")
  version               Int            @default(1)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  requester           Actor            @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee            Actor?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  team                Team?            @relation(fields: [teamId], references: [id])
  category            TicketCategory?  @relation(fields: [categoryId], references: [id])
  affectedSystem      BusinessSystem?  @relation(fields: [affectedSystemId], references: [id])
  requestedAction     BusinessAction?  @relation(fields: [requestedActionId], references: [id])
  requesterDepartment Department?      @relation("TicketRequesterDepartment", fields: [requesterDepartmentId], references: [id])
  previousDepartment  Department?      @relation("TicketPreviousDepartment", fields: [previousDepartmentId], references: [id])
  comments            TicketComment[]
  events              TicketEvent[]
  analyses            TicketAnalysis[]

  @@index([affectedSystemId])
  @@index([assigneeId])
  @@index([categoryId])
  @@index([previousDepartmentId])
  @@index([requestedActionId])
  @@index([requesterDepartmentId])
  @@index([requesterId])
  @@index([status])
  @@index([teamId])
  @@map("tickets")
}

model TicketComment {
  id         String                  @id @default(uuid()) @db.Uuid
  ticketId   String                  @map("ticket_id") @db.Uuid
  authorId   String                  @map("author_id") @db.Uuid
  content    String
  visibility TicketCommentVisibility @default(PUBLIC)
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author Actor  @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketEvent {
  id        String          @id @default(uuid()) @db.Uuid
  ticketId  String          @map("ticket_id") @db.Uuid
  actorId   String?         @map("actor_id") @db.Uuid
  type      TicketEventType
  payload   Json
  createdAt DateTime        @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id])
  actor  Actor? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([ticketId])
  @@map("ticket_events")
}

model TicketAnalysis {
  id                        String                @id @default(uuid()) @db.Uuid
  ticketId                  String                @map("ticket_id") @db.Uuid
  status                    TicketAnalysisStatus  @default(PENDING)
  trigger                   TicketAnalysisTrigger @default(MANUAL)
  ontologyVersion           String                @map("ontology_version")
  inputHash                 String                @map("input_hash")
  inputSnapshot             Json                  @map("input_snapshot")
  suggestedCategoryId       String?               @map("suggested_category_id") @db.Uuid
  classificationConfidence  Float?                @map("classification_confidence")
  classificationExplanation String?               @map("classification_explanation")
  startedAt                 DateTime?             @map("started_at")
  completedAt               DateTime?             @map("completed_at")
  failureReason             String?               @map("failure_reason")
  createdAt                 DateTime              @default(now()) @map("created_at")

  ticket            Ticket                          @relation(fields: [ticketId], references: [id])
  suggestedCategory TicketCategory?                 @relation(fields: [suggestedCategoryId], references: [id])
  requirements      AnalysisCapabilityRequirement[]
  evaluations       ActorEvaluation[]

  @@index([status])
  @@index([suggestedCategoryId])
  @@index([ticketId])
  @@map("ticket_analyses")
}

model AnalysisCapabilityRequirement {
  id           String                      @id @default(uuid()) @db.Uuid
  analysisId   String                      @map("analysis_id") @db.Uuid
  capabilityId String                      @map("capability_id") @db.Uuid
  source       CapabilityRequirementSource
  explanation  String
  createdAt    DateTime                    @default(now()) @map("created_at")

  analysis   TicketAnalysis @relation(fields: [analysisId], references: [id])
  capability Capability     @relation(fields: [capabilityId], references: [id])

  @@unique([analysisId, capabilityId, source])
  @@index([capabilityId])
  @@map("analysis_capability_requirements")
}

model ActorEvaluation {
  id               String   @id @default(uuid()) @db.Uuid
  analysisId       String   @map("analysis_id") @db.Uuid
  actorId          String   @map("actor_id") @db.Uuid
  eligible         Boolean
  rank             Int?
  suitabilityScore Float?   @map("suitability_score")
  reasons          Json
  createdAt        DateTime @default(now()) @map("created_at")

  analysis TicketAnalysis @relation(fields: [analysisId], references: [id])
  actor    Actor          @relation(fields: [actorId], references: [id])

  @@unique([analysisId, actorId])
  @@index([actorId])
  @@map("actor_evaluations")
}
